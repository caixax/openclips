import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { IconButton, KeyPill, Badge } from "widgets.slint";

/// Status strip in the reference style: the game, the buffer state, the
/// primary save hotkey and the capture quality.
export component TopBar inherits Rectangle {
    in property <string> game-name;
    in property <image> game-icon;
    in property <bool> has-game-icon;
    in property <bool> buffer-active;
    in property <string> buffer-label;
    in property <[string]> save-keys;
    in property <string> save-label;
    in property <string> quality;
    in property <bool> recording-active;
    callback toggle-buffer();
    callback save-clip();
    callback toggle-recording();

    height: Theme.topbar-height;
    background: Theme.background;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.divider;
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 16px;
        spacing: 14px;
        alignment: start;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            if root.has-game-icon: Image {
                y: (parent.height - self.height) / 2;
                width: 22px;
                height: 22px;
                source: root.game-icon;
            }
            if !root.has-game-icon: Icon {
                y: (parent.height - self.height) / 2;
                size: 16px;
                data: Icons.gamepad;
                color: Theme.text-muted;
            }
            Text {
                text: root.game-name;
                font-size: 14px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
        }

        Rectangle { width: 1px; height: 24px; y: (parent.height - self.height) / 2; background: Theme.divider; }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.buffer-active ? Theme.accent : Theme.text-faint;
            }
            Text {
                text: root.buffer-label;
                font-size: 12px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }

        Rectangle { width: 1px; height: 24px; y: (parent.height - self.height) / 2; background: Theme.divider; }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            KeyPill {
                y: (parent.height - self.height) / 2;
                keys: root.save-keys;
            }
            Text {
                text: root.save-label;
                font-size: 12px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }

        Rectangle { width: 1px; height: 24px; y: (parent.height - self.height) / 2; background: Theme.divider; }

        Text {
            text: root.quality;
            font-size: 12px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        HorizontalLayout {
            spacing: 4px;
            alignment: end;
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: root.buffer-active ? Icons.stop : Icons.play;
                icon-color: root.buffer-active ? Theme.text : Theme.accent;
                clicked => { root.toggle-buffer(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.scissors;
                enabled: root.buffer-active;
                clicked => { root.save-clip(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: root.recording-active ? Icons.stop : Icons.circle-dot;
                icon-color: Theme.record;
                active: root.recording-active;
                clicked => { root.toggle-recording(); }
            }
        }
    }
}
