export global Theme {
    out property <color> background: #0a0a0b;
    out property <color> surface: #141416;
    out property <color> surface-raised: #1b1b1e;
    out property <color> surface-hover: #222226;
    out property <color> border: #2a2a2f;
    out property <color> divider: #26262b;
    out property <color> text: #f4f4f5;
    out property <color> text-muted: #9a9aa3;
    out property <color> text-faint: #6b6b73;
    out property <color> accent: #c8f542;
    out property <color> accent-text: #0a0a0b;
    out property <color> danger: #ff4d4f;
    out property <color> warning: #f0b429;
    out property <color> success: #3ddc84;
    out property <color> record: #ff3b3b;

    out property <length> radius: 10px;
    out property <length> radius-small: 6px;
    out property <length> rail-width: 68px;
    out property <length> topbar-height: 56px;
    out property <length> page-padding: 28px;

    /// Set from the app; off turns every animation into an instant change.
    in-out property <bool> animations: true;
    out property <duration> quick: root.animations ? 120ms : 0ms;
    out property <duration> slow: root.animations ? 220ms : 0ms;
}
