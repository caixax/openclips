import { I18n } from "i18n.slint";

export component TrayIcon inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.png");
    tooltip: "OpenClips";
    title: "OpenClips";

    in property <bool> buffer-active;
    in property <bool> recording-active;

    callback open-window();
    callback toggle-buffer();
    callback save-clip();
    callback toggle-recording();
    callback quit();

    clicked => { root.open-window(); }

    Menu {
        MenuItem {
            title: I18n.tr("Open OpenClips");
            activated => { root.open-window(); }
        }
        MenuSeparator { }
        MenuItem {
            title: root.buffer-active ? I18n.tr("Stop replay buffer") : I18n.tr("Start replay buffer");
            activated => { root.toggle-buffer(); }
        }
        MenuItem {
            title: I18n.tr("Save clip now");
            enabled: root.buffer-active;
            activated => { root.save-clip(); }
        }
        MenuItem {
            title: root.recording-active ? I18n.tr("Stop recording") : I18n.tr("Start recording");
            activated => { root.toggle-recording(); }
        }
        MenuSeparator { }
        MenuItem {
            title: I18n.tr("Quit");
            activated => { root.quit(); }
        }
    }
}
