import { Palette, Button, LineEdit, Slider, ComboBox, CheckBox } from "std-widgets.slint";

export global PlayerState {
    in-out property <image> frame;
    in-out property <bool> playing: false;
    in-out property <float> position: 0;
    in-out property <float> duration: 0;
    in-out property <string> position-text: "0:00";
    in-out property <string> duration-text: "0:00";
    in-out property <float> volume: 100;
    in-out property <string> title;
    in-out property <string> details;
    in-out property <string> path;
    in-out property <string> message;
    in-out property <bool> renaming: false;
    in-out property <string> rename-text;
    in-out property <bool> confirm-delete: false;

    // Trim editor
    in-out property <bool> editing: false;
    in-out property <float> trim-in: 0;
    in-out property <float> trim-out: 0;
    in-out property <string> trim-in-text: "0:00.000";
    in-out property <string> trim-out-text: "0:00.000";
    in-out property <string> trim-summary;
    in-out property <int> trim-mode-index: 0;
    in-out property <bool> trim-overwrite: false;
    in-out property <bool> trim-busy: false;
    in-out property <string> trim-message;

    callback toggle-play();
    callback seek(float);
    callback volume-changed(float);
    callback back();
    callback rename();
    callback delete();
    callback reveal();
    callback set-in();
    callback set-out();
    callback set-in-at(float);
    callback set-out-at(float);
    callback preview-selection();
    callback save-trim();
    callback trim-changed();
}

component Timeline inherits Rectangle {
    height: 44px;
    property <float> span: max(PlayerState.duration, 0.01);
    property <length> track-x: 8px;
    property <length> track-width: root.width - 16px;
    property <length> in-x: root.track-x + root.track-width * PlayerState.trim-in / root.span;
    property <length> out-x: root.track-x + root.track-width * PlayerState.trim-out / root.span;
    property <length> head-x: root.track-x + root.track-width * PlayerState.position / root.span;

    function fraction-at(px: length) -> float {
        return clamp((px - root.track-x) / root.track-width, 0, 1);
    }

    Rectangle {
        x: root.track-x;
        y: 16px;
        width: root.track-width;
        height: 12px;
        border-radius: 6px;
        background: Palette.foreground.with-alpha(0.15);
    }
    if PlayerState.editing: Rectangle {
        x: root.in-x;
        y: 16px;
        width: max(root.out-x - root.in-x, 0);
        height: 12px;
        border-radius: 6px;
        background: Palette.accent-background.with-alpha(0.55);
    }
    Rectangle {
        x: root.head-x - 1px;
        y: 10px;
        width: 2px;
        height: 24px;
        background: Palette.foreground;
    }
    scrub := TouchArea {
        x: 0;
        y: 8px;
        width: root.width;
        height: 28px;
        clicked => { PlayerState.seek(root.fraction-at(self.mouse-x) * root.span); }
        moved => {
            if (self.pressed) {
                PlayerState.seek(root.fraction-at(self.mouse-x) * root.span);
            }
        }
    }
    if PlayerState.editing: Rectangle {
        x: root.in-x - 6px;
        y: 4px;
        width: 12px;
        height: 36px;
        border-radius: 3px;
        background: Palette.accent-background;
        TouchArea {
            moved => {
                if (self.pressed) {
                    PlayerState.set-in-at(root.fraction-at(parent.x + 6px + self.mouse-x - 6px) * root.span);
                }
            }
        }
    }
    if PlayerState.editing: Rectangle {
        x: root.out-x - 6px;
        y: 4px;
        width: 12px;
        height: 36px;
        border-radius: 3px;
        background: Palette.accent-background;
        TouchArea {
            moved => {
                if (self.pressed) {
                    PlayerState.set-out-at(root.fraction-at(parent.x + 6px + self.mouse-x - 6px) * root.span);
                }
            }
        }
    }
}

export component PlayerPage inherits Rectangle {
    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            Button {
                text: "Back";
                clicked => { PlayerState.back(); }
            }
            if !PlayerState.renaming: Text {
                text: PlayerState.title;
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if PlayerState.renaming: LineEdit {
                text <=> PlayerState.rename-text;
                horizontal-stretch: 1;
                accepted => { PlayerState.rename(); }
            }
            if PlayerState.renaming: Button {
                text: "Save name";
                primary: true;
                clicked => { PlayerState.rename(); }
            }
            if PlayerState.renaming: Button {
                text: "Cancel";
                clicked => { PlayerState.renaming = false; }
            }
            if !PlayerState.renaming: Button {
                text: "Rename";
                clicked => {
                    PlayerState.rename-text = PlayerState.title;
                    PlayerState.renaming = true;
                }
            }
            Button {
                text: PlayerState.editing ? "Close trim" : "Trim";
                clicked => { PlayerState.editing = !PlayerState.editing; }
            }
            Button {
                text: "Show in Explorer";
                clicked => { PlayerState.reveal(); }
            }
            if !PlayerState.confirm-delete: Button {
                text: "Delete";
                clicked => { PlayerState.confirm-delete = true; }
            }
            if PlayerState.confirm-delete: Button {
                text: "Confirm delete";
                primary: true;
                clicked => { PlayerState.delete(); }
            }
            if PlayerState.confirm-delete: Button {
                text: "Keep";
                clicked => { PlayerState.confirm-delete = false; }
            }
        }

        Text {
            text: PlayerState.details;
            font-size: 12px;
            color: Palette.foreground.with-alpha(0.6);
            overflow: elide;
        }

        if PlayerState.message != "": Rectangle {
            background: #d9534f30;
            border-color: #d9534f;
            border-width: 1px;
            border-radius: 8px;
            VerticalLayout {
                padding: 12px;
                Text { text: PlayerState.message; wrap: word-wrap; font-size: 13px; }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: black;
            border-radius: 8px;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: PlayerState.frame;
                image-fit: contain;
            }
            TouchArea {
                clicked => { PlayerState.toggle-play(); }
            }
        }

        Timeline { }

        HorizontalLayout {
            spacing: 12px;
            Button {
                text: PlayerState.playing ? "Pause" : "Play";
                width: 80px;
                clicked => { PlayerState.toggle-play(); }
            }
            Text {
                text: PlayerState.position-text + " / " + PlayerState.duration-text;
                vertical-alignment: center;
                font-size: 12px;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "Volume";
                vertical-alignment: center;
                font-size: 12px;
            }
            Slider {
                width: 120px;
                minimum: 0;
                maximum: 100;
                value <=> PlayerState.volume;
                changed(v) => { PlayerState.volume-changed(v); }
            }
        }

        if PlayerState.editing: Rectangle {
            background: Palette.alternate-background;
            border-radius: 10px;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Button {
                        text: "Set in";
                        clicked => { PlayerState.set-in(); }
                    }
                    Text {
                        text: PlayerState.trim-in-text;
                        vertical-alignment: center;
                        font-size: 13px;
                        width: 90px;
                    }
                    Button {
                        text: "Set out";
                        clicked => { PlayerState.set-out(); }
                    }
                    Text {
                        text: PlayerState.trim-out-text;
                        vertical-alignment: center;
                        font-size: 13px;
                        width: 90px;
                    }
                    Button {
                        text: "Preview selection";
                        clicked => { PlayerState.preview-selection(); }
                    }
                    Text {
                        text: PlayerState.trim-summary;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Palette.foreground.with-alpha(0.6);
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    ComboBox {
                        width: 220px;
                        model: ["Fast (cuts on keyframes)", "Exact (re-encodes)"];
                        current-index <=> PlayerState.trim-mode-index;
                        selected => { PlayerState.trim-changed(); }
                    }
                    CheckBox {
                        text: "Replace the original file";
                        checked <=> PlayerState.trim-overwrite;
                    }
                    Button {
                        text: PlayerState.trim-busy ? "Saving..." : (PlayerState.trim-overwrite ? "Overwrite original" : "Save as new clip");
                        primary: true;
                        enabled: !PlayerState.trim-busy;
                        clicked => { PlayerState.save-trim(); }
                    }
                }
                if PlayerState.trim-message != "": Text {
                    text: PlayerState.trim-message;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Drag the handles on the timeline or use Set in and Set out at the current position. Saving as a new clip never touches the original.";
                    font-size: 12px;
                    color: Palette.foreground.with-alpha(0.6);
                    wrap: word-wrap;
                }
            }
        }
    }
}
