import { LineEdit, Slider, ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { IconButton, TextButton, Notice, Toggle } from "widgets.slint";

export global PlayerState {
    in-out property <image> frame;
    in-out property <bool> playing: false;
    in-out property <float> position: 0;
    in-out property <float> duration: 0;
    in-out property <string> position-text: "0:00";
    in-out property <string> duration-text: "0:00";
    in-out property <float> volume: 100;
    in-out property <bool> muted: false;
    in-out property <string> title;
    in-out property <string> details;
    in-out property <string> path;
    in-out property <string> message;
    in-out property <bool> renaming: false;
    in-out property <string> rename-text;
    in-out property <bool> confirm-delete: false;

    // Trim editor
    in-out property <bool> editing: false;
    in-out property <float> trim-in: 0;
    in-out property <float> trim-out: 0;
    in-out property <string> trim-in-text: "0:00.000";
    in-out property <string> trim-out-text: "0:00.000";
    in-out property <string> trim-summary;
    in-out property <int> trim-mode-index: 0;
    in-out property <bool> trim-overwrite: false;
    in-out property <bool> trim-busy: false;
    in-out property <string> trim-message;

    callback toggle-play();
    callback seek(float);
    callback skip(float);
    callback volume-changed(float);
    callback toggle-mute();
    callback back();
    callback rename();
    callback delete();
    callback reveal();
    callback set-in();
    callback set-out();
    callback set-in-at(float);
    callback set-out-at(float);
    callback preview-selection();
    callback save-trim();
    callback trim-changed();
}

component Timeline inherits Rectangle {
    height: 36px;
    property <float> span: max(PlayerState.duration, 0.01);
    property <length> track-x: 8px;
    property <length> track-width: root.width - 16px;
    property <length> in-x: root.track-x + root.track-width * PlayerState.trim-in / root.span;
    property <length> out-x: root.track-x + root.track-width * PlayerState.trim-out / root.span;
    property <length> head-x: root.track-x + root.track-width * PlayerState.position / root.span;

    pure function fraction-at(px: length) -> float {
        return clamp((px - root.track-x) / root.track-width, 0, 1);
    }

    Rectangle {
        x: root.track-x;
        y: 15px;
        width: root.track-width;
        height: 6px;
        border-radius: 3px;
        background: #3a3a40;
    }
    Rectangle {
        x: root.track-x;
        y: 15px;
        width: max(root.head-x - root.track-x, 0);
        height: 6px;
        border-radius: 3px;
        background: PlayerState.editing ? #5a5a62 : Theme.accent;
    }
    if PlayerState.editing: Rectangle {
        x: root.in-x;
        y: 15px;
        width: max(root.out-x - root.in-x, 0);
        height: 6px;
        border-radius: 3px;
        background: Theme.accent;
    }
    Rectangle {
        x: root.head-x - 7px;
        y: 11px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.text;
    }
    scrub := TouchArea {
        x: 0;
        y: 4px;
        width: root.width;
        height: 28px;
        clicked => { PlayerState.seek(root.fraction-at(self.mouse-x) * root.span); }
        moved => {
            if (self.pressed) {
                PlayerState.seek(root.fraction-at(self.mouse-x) * root.span);
            }
        }
    }
    if PlayerState.editing: Rectangle {
        x: root.in-x - 6px;
        y: 2px;
        width: 12px;
        height: 32px;
        border-radius: 4px;
        background: Theme.accent;
        TouchArea {
            moved => {
                if (self.pressed) {
                    PlayerState.set-in-at(root.fraction-at(parent.x + self.mouse-x) * root.span);
                }
            }
        }
    }
    if PlayerState.editing: Rectangle {
        x: root.out-x - 6px;
        y: 2px;
        width: 12px;
        height: 32px;
        border-radius: 4px;
        background: Theme.accent;
        TouchArea {
            moved => {
                if (self.pressed) {
                    PlayerState.set-out-at(root.fraction-at(parent.x + self.mouse-x) * root.span);
                }
            }
        }
    }
}

component TrimPanel inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Icon { y: (parent.height - self.height) / 2; size: 14px; data: Icons.scissors; color: Theme.accent; }
            Text { text: "Trim"; font-size: 14px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: PlayerState.trim-summary; font-size: 12px; color: Theme.text-muted; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            TextButton { text: "Set in"; icon: Icons.chevron-right; has-icon: true; clicked => { PlayerState.set-in(); } }
            Text { text: PlayerState.trim-in-text; vertical-alignment: center; font-size: 13px; color: Theme.text; width: 80px; }
            TextButton { text: "Set out"; icon: Icons.chevron-right; has-icon: true; clicked => { PlayerState.set-out(); } }
            Text { text: PlayerState.trim-out-text; vertical-alignment: center; font-size: 13px; color: Theme.text; width: 80px; }
            TextButton { text: "Preview"; icon: Icons.play; has-icon: true; clicked => { PlayerState.preview-selection(); } }
        }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            ComboBox {
                width: 220px;
                model: ["Fast (cuts on keyframes)", "Exact (re-encodes)"];
                current-index <=> PlayerState.trim-mode-index;
                selected => { PlayerState.trim-changed(); }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Replace original"; font-size: 12px; color: Theme.text-muted; vertical-alignment: center; }
                Toggle { checked <=> PlayerState.trim-overwrite; }
            }
            Rectangle { horizontal-stretch: 1; }
            TextButton {
                text: PlayerState.trim-busy ? "Saving..." : (PlayerState.trim-overwrite ? "Overwrite original" : "Save as new clip");
                icon: Icons.floppy-disk;
                has-icon: true;
                kind: 1;
                enabled: !PlayerState.trim-busy;
                clicked => { PlayerState.save-trim(); }
            }
        }
        if PlayerState.trim-message != "": Text { text: PlayerState.trim-message; font-size: 12px; color: Theme.text; wrap: word-wrap; }
        Text {
            text: "Drag the handles on the timeline or use Set in and Set out at the playhead. Saving as a new clip never touches the original.";
            font-size: 11px;
            color: Theme.text-faint;
            wrap: word-wrap;
        }
    }
}

export component PlayerPage inherits Rectangle {
    background: Theme.background;
    VerticalLayout {
        padding: Theme.page-padding;
        padding-top: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 10px;
            IconButton { icon: Icons.arrow-left; filled: true; clicked => { PlayerState.back(); } }
            if !PlayerState.renaming: Text {
                text: PlayerState.title;
                font-size: 18px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if PlayerState.renaming: LineEdit {
                text <=> PlayerState.rename-text;
                horizontal-stretch: 1;
                accepted => { PlayerState.rename(); }
            }
            if PlayerState.renaming: TextButton { text: "Save name"; kind: 1; clicked => { PlayerState.rename(); } }
            if PlayerState.renaming: IconButton { icon: Icons.xmark; filled: true; clicked => { PlayerState.renaming = false; } }
            if !PlayerState.renaming: IconButton {
                icon: Icons.pen;
                filled: true;
                clicked => {
                    PlayerState.rename-text = PlayerState.title;
                    PlayerState.renaming = true;
                }
            }
            IconButton { icon: Icons.scissors; filled: true; active: PlayerState.editing; clicked => { PlayerState.editing = !PlayerState.editing; } }
            IconButton { icon: Icons.folder-open; filled: true; clicked => { PlayerState.reveal(); } }
            if !PlayerState.confirm-delete: IconButton { icon: Icons.trash; filled: true; icon-color: Theme.danger; clicked => { PlayerState.confirm-delete = true; } }
            if PlayerState.confirm-delete: TextButton { text: "Delete clip"; icon: Icons.trash; has-icon: true; kind: 2; clicked => { PlayerState.delete(); } }
            if PlayerState.confirm-delete: TextButton { text: "Keep"; clicked => { PlayerState.confirm-delete = false; } }
        }

        Text { text: PlayerState.details; font-size: 12px; color: Theme.text-muted; overflow: elide; }

        if PlayerState.message != "": Notice { message: PlayerState.message; kind: 2; }

        Rectangle {
            vertical-stretch: 1;
            background: black;
            border-radius: Theme.radius;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: PlayerState.frame;
                image-fit: contain;
            }
            TouchArea { clicked => { PlayerState.toggle-play(); } }
            if !PlayerState.playing: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 72px;
                height: 72px;
                border-radius: 36px;
                background: #000000a0;
                Icon {
                    x: (parent.width - self.width) / 2 + 3px;
                    y: (parent.height - self.height) / 2;
                    size: 30px;
                    data: Icons.play;
                    color: white;
                }
            }
        }

        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 10px;
                padding-top: 4px;
                spacing: 2px;
                Timeline { }
                HorizontalLayout {
                    spacing: 6px;
                    IconButton { icon: Icons.rotate-left; icon-size: 15px; clicked => { PlayerState.skip(-5); } }
                    IconButton {
                        icon: PlayerState.playing ? Icons.pause : Icons.play;
                        size: 40px;
                        icon-size: 18px;
                        filled: true;
                        clicked => { PlayerState.toggle-play(); }
                    }
                    IconButton { icon: Icons.rotate-right; icon-size: 15px; clicked => { PlayerState.skip(5); } }
                    Text {
                        text: PlayerState.position-text + " / " + PlayerState.duration-text;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.text-muted;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        icon: PlayerState.muted || PlayerState.volume == 0 ? Icons.volume-xmark : (PlayerState.volume < 50 ? Icons.volume-low : Icons.volume-high);
                        clicked => { PlayerState.toggle-mute(); }
                    }
                    Slider {
                        y: (parent.height - self.height) / 2;
                        width: 120px;
                        minimum: 0;
                        maximum: 100;
                        value <=> PlayerState.volume;
                        changed(v) => { PlayerState.volume-changed(v); }
                    }
                }
            }
        }

        if PlayerState.editing: TrimPanel { }
    }
}
