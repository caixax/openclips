export struct AppInfo {
    version: string,
    platform: string,
    config-path: string,
    clips-dir: string,
    log-dir: string,
}

export struct AudioSourceRow {
    id: string,
    kind: string,
    name: string,
    enabled: bool,
    volume: float,
    muted: bool,
    connected: bool,
}

export struct ClipCard {
    id: string,
    title: string,
    game: string,
    date: string,
    duration: string,
    thumbnail: image,
    has-thumbnail: bool,
}
