/// A single colour icon drawn from path data, sized by `size`.
export component Icon {
    in property <IconData> data;
    in property <color> color: #f2f2f2;
    in property <length> size: 16px;
    width: root.size;
    height: root.size;
    Path {
        width: parent.width;
        height: parent.height;
        commands: root.data.commands;
        viewbox-x: -(root.data.height - root.data.width) / 2;
        viewbox-y: 0;
        viewbox-width: root.data.height;
        viewbox-height: root.data.height;
        fill: root.color;
    }
}
