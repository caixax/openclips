import { ComboBox, SpinBox, LineEdit, ScrollView, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { I18n } from "i18n.slint";
import { Icon, Icons } from "icons.slint";
import { IconButton, TextButton, Toggle, SectionCard, SettingRow, Divider, KeyPill, Badge, Notice, AddButton, OptionCard, PageHeader } from "widgets.slint";
import { AppInfo, AudioSourceRow, GameProfileRow, HotkeyRow } from "types.slint";

export global SettingsState {
    in-out property <[string]> display-names: [I18n.tr("Primary display")];
    in-out property <int> display-index: 0;
    in-out property <[string]> encoder-names: [I18n.tr("Automatic (best available)"), "NVIDIA NVENC", "Intel Quick Sync", "AMD AMF", I18n.tr("Software (x264)")];
    in-out property <int> encoder-index: 0;
    in-out property <int> quality-index: 1;
    in-out property <int> fps: 60;
    in-out property <int> bitrate-kbps: 15000;
    in-out property <bool> show-cursor: false;
    in-out property <bool> stretch: false;
    in-out property <int> capture-api-index: 0;
    in-out property <bool> launch-on-startup: false;
    in-out property <bool> clip-sound: false;
    in-out property <bool> clip-toast: true;
    in-out property <bool> animations: true;
    in-out property <int> language-index: 0;

    in-out property <int> replay-length-value: 30;
    in-out property <int> replay-unit-index: 0;
    in-out property <int> memory-cap-mb: 1024;
    in-out property <bool> start-on-launch: true;
    in-out property <bool> start-minimized: false;
    in-out property <bool> updates-check: true;
    in-out property <bool> discord-enabled: true;
    in-out property <bool> discord-show-game: true;
    in-out property <string> discord-client-id;

    in-out property <string> clips-dir;
    in-out property <string> file-name-pattern;
    in-out property <string> clips-subfolder;
    in-out property <string> recording-subfolder;
    in-out property <string> edited-subfolder;
    in-out property <string> storage-line;
    in-out property <float> storage-fraction: 0;

    in-out property <bool> audio-enabled: true;
    in-out property <bool> separate-tracks: false;
    in-out property <int> audio-bitrate-kbps: 160;
    in-out property <[AudioSourceRow]> audio-sources: [];
    in-out property <[string]> app-candidates: [];
    in-out property <int> app-candidate-index: 0;
    in-out property <string> new-app-exe;

    in-out property <int> games-scope-index: 0;
    in-out property <[GameProfileRow]> game-profiles: [];
    in-out property <[string]> profile-display-names: [I18n.tr("Use the global display")];
    in-out property <string> running-games;
    in-out property <[string]> running-known: [];
    in-out property <int> running-known-index: 0;
    in-out property <string> new-game-exe;
    in-out property <string> new-game-name;
    in-out property <string> games-message;
    in-out property <bool> steam-busy: false;

    in-out property <[HotkeyRow]> hotkeys: [];
    in-out property <int> listening-action: -1;

    in-out property <string> message;
    in-out property <bool> message-is-error: false;

    /// Something the config stores changed; the app saves shortly after.
    /// Rows (hotkeys, audio sources, games) report through their controls.
    callback changed();
    changed display-index => { root.changed(); }
    changed encoder-index => { root.changed(); }
    changed fps => { root.changed(); }
    changed bitrate-kbps => { root.changed(); }
    changed show-cursor => { root.changed(); }
    changed stretch => { root.changed(); }
    changed capture-api-index => { root.changed(); }
    changed launch-on-startup => { root.changed(); }
    changed clip-sound => { root.changed(); }
    changed clip-toast => { root.changed(); }
    changed animations => { root.changed(); }
    changed language-index => { root.changed(); }
    changed replay-length-value => { root.changed(); }
    changed replay-unit-index => { root.changed(); }
    changed memory-cap-mb => { root.changed(); }
    changed start-on-launch => { root.changed(); }
    changed start-minimized => { root.changed(); }
    changed updates-check => { root.changed(); }
    changed discord-enabled => { root.changed(); }
    changed discord-show-game => { root.changed(); }
    changed discord-client-id => { root.changed(); }
    changed clips-dir => { root.changed(); }
    changed file-name-pattern => { root.changed(); }
    changed clips-subfolder => { root.changed(); }
    changed recording-subfolder => { root.changed(); }
    changed edited-subfolder => { root.changed(); }
    changed audio-enabled => { root.changed(); }
    changed separate-tracks => { root.changed(); }
    changed audio-bitrate-kbps => { root.changed(); }
    changed games-scope-index => { root.changed(); }
    callback browse-clips-dir();
    callback refresh-displays();
    callback refresh-audio-devices();
    callback refresh-apps();
    callback key-captured(int, string, bool, bool, bool, bool);
    callback add-running-game();
    callback add-game();
    callback remove-game(string);
    callback suggest-steam-names();
    callback add-hotkey();
    callback remove-hotkey(int);
    callback add-app-audio(string);
    callback remove-audio-source(string);
}

export component HotkeyCapture inherits FocusScope {
    in property <int> action;
    in property <[string]> keys;
    property <bool> listening: SettingsState.listening-action == root.action;

    width: pill.preferred-width;
    height: 32px;

    pill := KeyPill {
        y: (parent.height - self.height) / 2;
        keys: root.keys;
        listening: root.listening;
    }
    TouchArea {
        clicked => {
            if (root.listening) {
                SettingsState.listening-action = -1;
            } else {
                SettingsState.listening-action = root.action;
                root.focus();
            }
        }
    }
    key-pressed(event) => {
        if (root.listening) {
            SettingsState.key-captured(root.action, event.text, event.modifiers.alt, event.modifiers.control, event.modifiers.shift, event.modifiers.meta);
            return accept;
        }
        return reject;
    }
    changed has-focus => {
        if (!self.has-focus && root.listening) {
            SettingsState.listening-action = -1;
        }
    }
}

component Label inherits Text {
    font-size: 12px;
    color: Theme.text-muted;
    vertical-alignment: center;
}

component Hint inherits Text {
    font-size: 11px;
    color: Theme.text-faint;
    wrap: word-wrap;
}

component StorageBar inherits Rectangle {
    height: 8px;
    border-radius: 4px;
    background: Theme.surface-hover;
    Rectangle {
        x: 0;
        width: parent.width * clamp(SettingsState.storage-fraction, 0, 1);
        height: parent.height;
        border-radius: 4px;
        background: SettingsState.storage-fraction > 0.9 ? Theme.danger : Theme.accent;
    }
}

export component SettingsPage inherits ScrollView {
    in property <AppInfo> info;
    in property <string> update-status;
    in property <bool> buffer-active;
    in property <string> buffer-status;
    in property <string> buffer-detail;
    in property <string> encoder-name;
    in property <string> detected-game;
    in property <string> recording-status;
    callback open-config-dir();
    callback open-clips-dir();
    callback open-logs-dir();

    VerticalLayout {
        padding: Theme.page-padding;
        padding-top: 20px;
        spacing: 18px;
        alignment: start;

        HorizontalLayout {
            spacing: 12px;
            PageHeader {
                icon: Icons.gear;
                title: I18n.tr("Settings");
                description: I18n.tr("Capture, audio, games, storage and hotkeys. Every change is saved and applied right away.");
            }
        }

        if SettingsState.message != "": Notice { message: SettingsState.message; kind: SettingsState.message-is-error ? 2 : 3; }

        SectionCard {
            heading: I18n.tr("Hotkeys");
            subtitle: I18n.tr("Global shortcuts that work while a game has focus. Click a key to change it, Escape cancels. Every row is a key plus what it does.");

            for hk[i] in SettingsState.hotkeys: HorizontalLayout {
                spacing: 12px;
                alignment: start;
                HotkeyCapture { action: 100 + i; keys: hk.keys; }
                ComboBox {
                    width: 210px;
                    model: [I18n.tr("Save replay"), I18n.tr("Start or stop the buffer"), I18n.tr("Start or stop recording")];
                    current-index <=> hk.action-index; changed current-index => { SettingsState.changed(); }
                }
                if hk.action-index == 0: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Label { text: I18n.tr("last"); }
                    SpinBox { width: 90px; minimum: 0; maximum: 60; value <=> hk.minutes; changed value => { SettingsState.changed(); } }
                    Label { text: I18n.tr("min"); }
                    SpinBox { width: 90px; minimum: 0; maximum: 59; value <=> hk.seconds; changed value => { SettingsState.changed(); } }
                    Label { text: I18n.tr("s"); }
                    Label {
                        text: hk.minutes == 0 && hk.seconds == 0 ? I18n.tr("= whole buffer") : "";
                        color: Theme.text-faint;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                IconButton {
                    icon: Icons.trash;
                    icon-color: Theme.danger;
                    enabled: SettingsState.hotkeys.length > 1;
                    clicked => { SettingsState.remove-hotkey(i); }
                }
            }
            AddButton { text: I18n.tr("Add hotkey"); clicked => { SettingsState.add-hotkey(); } }
            Hint { text: I18n.tr("A save hotkey with 0 min 0 s saves everything the buffer holds. The buffer below grows on its own to fit the longest save hotkey."); }
        }

        SectionCard {
            heading: I18n.tr("Quality");
            subtitle: I18n.tr("Resolution follows the captured display. Presets set frame rate and bitrate.");
            HorizontalLayout {
                spacing: 12px;
                OptionCard {
                    title: I18n.tr("Low");
                    detail: I18n.tr("30 fps, 8 Mbps. Small files.");
                    selected: SettingsState.quality-index == 0;
                    clicked => { SettingsState.quality-index = 0; SettingsState.fps = 30; SettingsState.bitrate-kbps = 8000; }
                }
                OptionCard {
                    title: I18n.tr("Standard");
                    detail: I18n.tr("60 fps, 15 Mbps. Good for sharing.");
                    selected: SettingsState.quality-index == 1;
                    clicked => { SettingsState.quality-index = 1; SettingsState.fps = 60; SettingsState.bitrate-kbps = 15000; }
                }
                OptionCard {
                    title: I18n.tr("High");
                    detail: I18n.tr("60 fps, 30 Mbps. Best detail.");
                    selected: SettingsState.quality-index == 2;
                    clicked => { SettingsState.quality-index = 2; SettingsState.fps = 60; SettingsState.bitrate-kbps = 30000; }
                }
                OptionCard {
                    title: I18n.tr("Custom");
                    detail: "\{SettingsState.fps} fps, \{round(SettingsState.bitrate-kbps / 100) / 10} Mbps";
                    selected: SettingsState.quality-index == 3;
                    clicked => { SettingsState.quality-index = 3; }
                }
            }
            if SettingsState.quality-index == 3: HorizontalLayout {
                spacing: 16px;
                alignment: start;
                Label { text: I18n.tr("Frame rate"); }
                SpinBox { width: 110px; minimum: 15; maximum: 240; value <=> SettingsState.fps; }
                Label { text: I18n.tr("Bitrate (kbps)"); }
                SpinBox { width: 130px; minimum: 1000; maximum: 200000; step-size: 1000; value <=> SettingsState.bitrate-kbps; }
            }
            Divider { }
            SettingRow {
                title: I18n.tr("Encoder");
                description: I18n.tr("Automatic prefers the GPU encoder and falls back to software.");
                ComboBox { width: 240px; model: SettingsState.encoder-names; current-index <=> SettingsState.encoder-index; }
            }
            SettingRow {
                title: I18n.tr("Display");
                description: I18n.tr("The screen that gets captured.");
                HorizontalLayout {
                    spacing: 6px;
                    ComboBox { width: 240px; model: SettingsState.display-names; current-index <=> SettingsState.display-index; }
                    IconButton { icon: Icons.arrows-rotate; filled: true; size: 32px; clicked => { SettingsState.refresh-displays(); } }
                }
            }
            SettingRow {
                title: I18n.tr("Capture method");
                description: I18n.tr("Windows Graphics Capture delivers every frame, also on high refresh displays. Desktop Duplication is the fallback and repeats frames under load.");
                ComboBox { width: 240px; model: [I18n.tr("Desktop Duplication"), I18n.tr("Windows Graphics Capture")]; current-index <=> SettingsState.capture-api-index; }
            }
            SettingRow {
                title: I18n.tr("Stretch to the display");
                description: I18n.tr("Games running in a 4:3 or other narrow fullscreen mode are scaled to the display's desktop resolution, so the clip looks like what you saw on the monitor.");
                Toggle { checked <=> SettingsState.stretch; }
            }
            SettingRow {
                title: I18n.tr("Show cursor");
                description: I18n.tr("Draw the mouse pointer into clips. Only with Windows Graphics Capture: Desktop Duplication leaves it out, because GStreamer crashes drawing it when a game changes the display mode.");
                Toggle { checked <=> SettingsState.show-cursor; }
            }
        }

        SectionCard {
            heading: I18n.tr("Replay buffer");
            subtitle: I18n.tr("The last moments stay in memory and never touch the disk until you save.");
            SettingRow {
                title: I18n.tr("Buffer length");
                description: I18n.tr("How far back a save can reach. Longer buffers use more memory.");
                HorizontalLayout {
                    spacing: 6px;
                    SpinBox { width: 100px; minimum: 1; maximum: 3600; value <=> SettingsState.replay-length-value; }
                    ComboBox { width: 110px; model: [I18n.tr("seconds"), I18n.tr("minutes")]; current-index <=> SettingsState.replay-unit-index; }
                }
            }
            SettingRow {
                title: I18n.tr("Memory cap");
                description: I18n.tr("Upper bound in MB. The buffer shrinks to fit.");
                SpinBox { width: 120px; minimum: 64; maximum: 32768; step-size: 64; value <=> SettingsState.memory-cap-mb; }
            }
            SettingRow {
                title: I18n.tr("Start buffer on launch");
                description: I18n.tr("Begin capturing as soon as OpenClips opens.");
                Toggle { checked <=> SettingsState.start-on-launch; }
            }
        }

        SectionCard {
            heading: I18n.tr("Storage");
            subtitle: I18n.tr("Where clips, recordings and edits are written. Type a path or browse for a folder.");
            SettingRow {
                title: I18n.tr("Root folder");
                description: I18n.tr("Everything goes under this folder.");
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit { width: 360px; text <=> SettingsState.clips-dir; }
                    TextButton { text: I18n.tr("Browse"); icon: Icons.folder-open; has-icon: true; clicked => { SettingsState.browse-clips-dir(); } }
                }
            }
            VerticalLayout {
                spacing: 6px;
                StorageBar { }
                Hint { text: SettingsState.storage-line; }
            }
            SettingRow {
                title: I18n.tr("Subfolders");
                description: I18n.tr("Clips, recordings and edited files each get their own subfolder. Leave one empty to use the root.");
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit { width: 120px; placeholder-text: I18n.tr("Clips"); text <=> SettingsState.clips-subfolder; }
                    LineEdit { width: 120px; placeholder-text: I18n.tr("Recordings"); text <=> SettingsState.recording-subfolder; }
                    LineEdit { width: 120px; placeholder-text: I18n.tr("Edited"); text <=> SettingsState.edited-subfolder; }
                }
            }
            SettingRow {
                title: I18n.tr("File name pattern");
                description: I18n.tr("Placeholders: {game} {date} {time}");
                LineEdit { width: 260px; text <=> SettingsState.file-name-pattern; }
            }
        }

        SectionCard {
            heading: I18n.tr("Audio");
            subtitle: I18n.tr("Outputs are captured through loopback, inputs are microphones. Volume and mute apply live.");
            SettingRow {
                title: I18n.tr("Record audio");
                description: I18n.tr("Turn off to save video only.");
                Toggle { checked <=> SettingsState.audio-enabled; }
            }
            SettingRow {
                title: I18n.tr("Separate tracks");
                description: I18n.tr("Desktop and microphone on their own tracks so you can mute one later.");
                Toggle { checked <=> SettingsState.separate-tracks; enabled: SettingsState.audio-enabled; }
            }
            SettingRow {
                title: I18n.tr("Audio bitrate");
                description: I18n.tr("AAC kbps per track.");
                SpinBox { width: 110px; minimum: 64; maximum: 320; step-size: 32; value <=> SettingsState.audio-bitrate-kbps; }
            }
            Divider { }
            for row in SettingsState.audio-sources: HorizontalLayout {
                spacing: 12px;
                alignment: start;
                Toggle { y: (parent.height - self.height) / 2; checked <=> row.enabled; changed checked => { SettingsState.changed(); } }
                Icon {
                    y: (parent.height - self.height) / 2;
                    size: 14px;
                    data: row.kind == "output" ? Icons.headphones : (row.kind == "app" ? Icons.layer-group : Icons.microphone);
                    color: row.connected ? Theme.text : Theme.text-faint;
                }
                Text {
                    text: row.connected ? row.name : row.name + I18n.tr(" (not connected)");
                    width: 260px;
                    vertical-alignment: center;
                    font-size: 13px;
                    overflow: elide;
                    color: row.connected ? Theme.text : Theme.text-faint;
                }
                Badge { y: (parent.height - self.height) / 2; text: row.kind == "output" ? I18n.tr("Output") : (row.kind == "app" ? I18n.tr("App track") : I18n.tr("Input")); }
                Slider {
                    y: (parent.height - self.height) / 2;
                    width: 150px;
                    minimum: 0;
                    maximum: 200;
                    value <=> row.volume; changed value => { SettingsState.changed(); }
                    enabled: row.enabled && !row.muted;
                }
                Label { text: "\{round(row.volume)}%"; width: 44px; }
                IconButton {
                    icon: row.muted ? Icons.volume-xmark : Icons.volume-high;
                    icon-color: row.muted ? Theme.danger : Theme.text;
                    size: 32px;
                    enabled: row.enabled;
                    clicked => { row.muted = !row.muted; SettingsState.changed(); }
                }
                if row.kind == "app": IconButton {
                    icon: Icons.trash;
                    icon-color: Theme.danger;
                    size: 32px;
                    clicked => { SettingsState.remove-audio-source(row.id); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                TextButton { text: I18n.tr("Refresh devices"); icon: Icons.arrows-rotate; has-icon: true; clicked => { SettingsState.refresh-audio-devices(); } }
            }
            Divider { }
            SettingRow {
                title: I18n.tr("Application audio");
                description: I18n.tr("Give one program (Discord, Spotify, a browser) its own track, so you can mute it in the editor. Pick a running program or type its executable.");
                HorizontalLayout {
                    spacing: 6px;
                    ComboBox {
                        width: 200px;
                        model: SettingsState.app-candidates;
                        current-index <=> SettingsState.app-candidate-index;
                        enabled: SettingsState.app-candidates.length > 0;
                    }
                    IconButton { icon: Icons.arrows-rotate; filled: true; size: 32px; clicked => { SettingsState.refresh-apps(); } }
                    TextButton {
                        text: I18n.tr("Add");
                        icon: Icons.plus;
                        has-icon: true;
                        enabled: SettingsState.app-candidates.length > 0;
                        clicked => { SettingsState.add-app-audio(SettingsState.app-candidates[SettingsState.app-candidate-index]); }
                    }
                    LineEdit { width: 140px; placeholder-text: "discord.exe"; text <=> SettingsState.new-app-exe; accepted => { SettingsState.add-app-audio(SettingsState.new-app-exe); } }
                    TextButton { text: I18n.tr("Add typed"); clicked => { SettingsState.add-app-audio(SettingsState.new-app-exe); } }
                }
            }
            Hint { text: I18n.tr("The first application track is left out of the default desktop output so it is not recorded twice. The program has to be running when capture starts; capture restarts on its own when it opens or closes."); }
        }

        SectionCard {
            heading: I18n.tr("Games");
            subtitle: I18n.tr("Capture only while a known game runs, with a profile per game. Names, actions and folders are editable.");
            SettingRow {
                title: I18n.tr("Capture scope");
                description: I18n.tr("Always capture, or only while one of the games below is running.");
                ComboBox { width: 300px; model: [I18n.tr("Always capture the selected display"), I18n.tr("Only while a known game is running")]; current-index <=> SettingsState.games-scope-index; }
            }
            Hint { text: SettingsState.running-games; }
            for profile in SettingsState.game-profiles: HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: Theme.surface-raised;
                    if profile.has-icon: Image { width: 22px; height: 22px; x: 3px; y: 3px; source: profile.icon; }
                    if !profile.has-icon: Icon { x: 7px; y: 7px; size: 14px; data: Icons.gamepad; color: Theme.text-muted; }
                }
                VerticalLayout {
                    width: 190px;
                    spacing: 2px;
                    alignment: center;
                    LineEdit { placeholder-text: I18n.tr("Display name"); text <=> profile.name; changed text => { SettingsState.changed(); } }
                    Text { text: profile.exe; font-size: 11px; color: Theme.text-faint; overflow: elide; }
                }
                ComboBox { width: 150px; model: [I18n.tr("Replay buffer"), I18n.tr("Full recording"), I18n.tr("Do nothing")]; current-index <=> profile.action-index; changed current-index => { SettingsState.changed(); } }
                SpinBox { width: 90px; minimum: 0; maximum: 3600; value <=> profile.replay-seconds; changed value => { SettingsState.changed(); } }
                LineEdit { width: 120px; placeholder-text: I18n.tr("Subfolder"); text <=> profile.subfolder; changed text => { SettingsState.changed(); } }
                ComboBox { width: 160px; model: SettingsState.profile-display-names; current-index <=> profile.display-index; changed current-index => { SettingsState.changed(); } }
                IconButton { icon: Icons.trash; icon-color: Theme.danger; size: 32px; clicked => { SettingsState.remove-game(profile.exe); } }
            }
            Hint { text: I18n.tr("Columns: name, action when the game starts, buffer length override in seconds (0 keeps the global one), clip subfolder, display."); }
            Divider { }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                ComboBox {
                    width: 260px;
                    model: SettingsState.running-known;
                    current-index <=> SettingsState.running-known-index;
                    enabled: SettingsState.running-known.length > 0;
                }
                TextButton {
                    text: I18n.tr("Add running game");
                    icon: Icons.plus;
                    has-icon: true;
                    enabled: SettingsState.running-known.length > 0;
                    clicked => { SettingsState.add-running-game(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                LineEdit { width: 200px; placeholder-text: "game.exe"; text <=> SettingsState.new-game-exe; }
                LineEdit { width: 200px; placeholder-text: I18n.tr("Display name (optional)"); text <=> SettingsState.new-game-name; }
                TextButton { text: I18n.tr("Add"); icon: Icons.plus; has-icon: true; clicked => { SettingsState.add-game(); } }
                TextButton {
                    text: SettingsState.steam-busy ? I18n.tr("Asking Steam...") : I18n.tr("Suggest names from Steam");
                    icon: Icons.download;
                    has-icon: true;
                    kind: 3;
                    enabled: !SettingsState.steam-busy;
                    clicked => { SettingsState.suggest-steam-names(); }
                }
            }
            if SettingsState.games-message != "": Hint { text: SettingsState.games-message; color: Theme.text-muted; }
            Hint { text: I18n.tr("Names come from the bundled database. The Steam lookup only runs when you press the button and fills empty names."); }
        }

        SectionCard {
            heading: I18n.tr("General");
            subtitle: "";
            SettingRow {
                title: I18n.tr("Language");
                description: I18n.tr("The interface language. Applied right away.");
                ComboBox { width: 200px; model: ["English", "Español", "Français", "Deutsch", "Русский", "Português", "Italiano"]; current-index <=> SettingsState.language-index; }
            }
            SettingRow {
                title: I18n.tr("Launch with Windows");
                description: I18n.tr("Adds OpenClips to the current user's startup entries.");
                Toggle { checked <=> SettingsState.launch-on-startup; }
            }
            SettingRow {
                title: I18n.tr("Start in the tray when launched with Windows");
                description: I18n.tr("Only applies to the Windows startup launch. Opening OpenClips yourself always shows the window.");
                Toggle { checked <=> SettingsState.start-minimized; }
            }
            SettingRow {
                title: I18n.tr("Animations");
                description: I18n.tr("Short fades on hover, toggles and page changes. Off makes every change instant.");
                Toggle { checked <=> SettingsState.animations; }
            }
            SettingRow {
                title: I18n.tr("Sound when a clip is saved");
                description: I18n.tr("A short click confirms the save, so you know the hotkey worked without looking.");
                Toggle { checked <=> SettingsState.clip-sound; }
            }
            SettingRow {
                title: I18n.tr("Notice when a clip is saved");
                description: I18n.tr("A small card at the bottom right of the screen says how many seconds were clipped.");
                Toggle { checked <=> SettingsState.clip-toast; }
            }
            SettingRow {
                title: I18n.tr("Check for updates at start");
                description: I18n.tr("Looks at the GitHub releases once when the app opens. A new version is downloaded in the background and installed on the next start, or right away from the banner.");
                Toggle { checked <=> SettingsState.updates-check; }
            }
        }

        SectionCard {
            heading: I18n.tr("Discord");
            subtitle: I18n.tr("Shows \"Clipping <game>\" as your Discord activity while the buffer or a recording runs, like Medal does.");
            SettingRow {
                title: I18n.tr("Discord Rich Presence");
                description: I18n.tr("Turn off to show nothing in Discord.");
                Toggle { checked <=> SettingsState.discord-enabled; }
            }
            SettingRow {
                title: I18n.tr("Show the game name");
                description: I18n.tr("Off shows just \"Clipping\".");
                Toggle { checked <=> SettingsState.discord-show-game; enabled: SettingsState.discord-enabled; }
            }
            SettingRow {
                title: I18n.tr("Discord application id");
                description: I18n.tr("Leave empty to use the built in OpenClips application. Paste your own Application ID from discord.com/developers to show a different name or artwork.");
                LineEdit { width: 260px; placeholder-text: I18n.tr("Built in"); text <=> SettingsState.discord-client-id; enabled: SettingsState.discord-enabled; }
            }
        }

        SectionCard {
            heading: I18n.tr("Status");
            subtitle: I18n.tr("What capture is doing right now.");
            SettingRow {
                title: root.buffer-status;
                description: root.buffer-active ? root.buffer-detail : I18n.tr("The replay buffer is stopped.");
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.buffer-active ? Theme.accent : Theme.text-faint;
                }
            }
            SettingRow {
                title: I18n.tr("Encoder");
                description: root.encoder-name;
            }
            SettingRow {
                title: I18n.tr("Game");
                description: root.detected-game;
            }
            SettingRow {
                title: I18n.tr("Recording");
                description: root.recording-status;
            }
        }

        SectionCard {
            heading: I18n.tr("About");
            subtitle: "OpenClips " + root.info.version + " for " + root.info.platform + ". MIT licensed, no cloud, no telemetry.";
            SettingRow {
                title: I18n.tr("Version");
                description: root.info.version;
            }
            SettingRow {
                title: I18n.tr("Updates");
                description: root.update-status;
            }
            SettingRow {
                title: I18n.tr("Config file");
                description: root.info.config-path;
                TextButton { text: I18n.tr("Open folder"); icon: Icons.folder-open; has-icon: true; clicked => { root.open-config-dir(); } }
            }
            SettingRow {
                title: I18n.tr("Clips folder");
                description: root.info.clips-dir;
                TextButton { text: I18n.tr("Open folder"); icon: Icons.folder-open; has-icon: true; clicked => { root.open-clips-dir(); } }
            }
            SettingRow {
                title: I18n.tr("Logs");
                description: root.info.log-dir;
                TextButton { text: I18n.tr("Open folder"); icon: Icons.folder-open; has-icon: true; clicked => { root.open-logs-dir(); } }
            }
        }
    }
}
