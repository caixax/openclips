import { Palette, Button, ComboBox, SpinBox, LineEdit, CheckBox, ScrollView, Slider } from "std-widgets.slint";
import { AudioSourceRow, GameProfileRow } from "types.slint";

export global SettingsState {
    in-out property <[string]> display-names: ["Primary display"];
    in-out property <int> display-index: 0;
    in-out property <[string]> encoder-names: ["Automatic (best available)", "NVIDIA NVENC", "Intel Quick Sync", "AMD AMF", "Software (x264)"];
    in-out property <int> encoder-index: 0;
    in-out property <int> fps: 60;
    in-out property <int> bitrate-kbps: 20000;
    in-out property <bool> show-cursor: false;

    in-out property <int> replay-length-value: 30;
    in-out property <int> replay-unit-index: 0;
    in-out property <int> memory-cap-mb: 1024;
    in-out property <bool> start-on-launch: true;
    in-out property <bool> start-minimized: false;

    in-out property <string> clips-dir;
    in-out property <string> file-name-pattern;
    in-out property <string> recording-subfolder;

    in-out property <bool> audio-enabled: true;
    in-out property <bool> separate-tracks: false;
    in-out property <int> audio-bitrate-kbps: 160;
    in-out property <[AudioSourceRow]> audio-sources: [];

    in-out property <int> games-scope-index: 0;
    in-out property <[GameProfileRow]> game-profiles: [];
    in-out property <[string]> profile-display-names: ["Use the global display"];
    in-out property <string> running-games;
    in-out property <[string]> running-known: [];
    in-out property <int> running-known-index: 0;
    in-out property <string> new-game-exe;
    in-out property <string> new-game-name;
    in-out property <string> games-message;
    in-out property <bool> steam-busy: false;

    in-out property <string> hotkey-save-replay;
    in-out property <string> hotkey-toggle-buffer;
    in-out property <string> hotkey-toggle-recording;
    in-out property <int> listening-action: -1;

    in-out property <string> message;
    in-out property <bool> message-is-error: false;

    callback save();
    callback revert();
    callback browse-clips-dir();
    callback refresh-displays();
    callback refresh-audio-devices();
    callback key-captured(int, string, bool, bool, bool, bool);
    callback add-running-game();
    callback add-game();
    callback remove-game(string);
    callback suggest-steam-names();
}

component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 12px;
    alignment: start;
    Text {
        text: root.label;
        width: 190px;
        vertical-alignment: center;
        font-size: 13px;
        color: Palette.foreground.with-alpha(0.7);
    }
    @children
}

component Section inherits Rectangle {
    in property <string> heading;
    background: Palette.alternate-background;
    border-radius: 10px;
    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        Text {
            text: root.heading;
            font-size: 16px;
            font-weight: 600;
        }
        @children
    }
}

component Hint inherits Text {
    color: Palette.foreground.with-alpha(0.6);
    font-size: 12px;
    wrap: word-wrap;
}

component HotkeyRow inherits Field {
    in property <int> action;
    in-out property <string> binding;
    property <bool> listening: SettingsState.listening-action == root.action;

    fs := FocusScope {
        width: 180px;
        height: 32px;
        Rectangle {
            border-radius: 6px;
            border-width: 1px;
            border-color: root.listening ? Palette.accent-background : Palette.border;
            background: Palette.background;
            Text {
                text: root.listening ? "Press a key..." : root.binding;
                vertical-alignment: center;
                horizontal-alignment: center;
                font-size: 13px;
            }
        }
        key-pressed(event) => {
            if (root.listening) {
                SettingsState.key-captured(root.action, event.text, event.modifiers.alt, event.modifiers.control, event.modifiers.shift, event.modifiers.meta);
                return accept;
            }
            return reject;
        }
    }
    Button {
        text: root.listening ? "Cancel" : "Change";
        clicked => {
            if (root.listening) {
                SettingsState.listening-action = -1;
            } else {
                SettingsState.listening-action = root.action;
                fs.focus();
            }
        }
    }
}

export component SettingsPage inherits ScrollView {
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        Text {
            text: "Settings";
            font-size: 26px;
            font-weight: 700;
        }

        if SettingsState.message != "": Rectangle {
            property <color> tint: SettingsState.message-is-error ? #d9534f : #3c9a5f;
            background: self.tint.with-alpha(0.18);
            border-color: self.tint;
            border-width: 1px;
            border-radius: 8px;
            VerticalLayout {
                padding: 12px;
                Text {
                    text: SettingsState.message;
                    wrap: word-wrap;
                    font-size: 13px;
                }
            }
        }

        Section {
            heading: "Capture";
            Field {
                label: "Display";
                ComboBox {
                    width: 320px;
                    model: SettingsState.display-names;
                    current-index <=> SettingsState.display-index;
                }
                Button {
                    text: "Refresh";
                    clicked => { SettingsState.refresh-displays(); }
                }
            }
            Field {
                label: "Encoder";
                ComboBox {
                    width: 320px;
                    model: SettingsState.encoder-names;
                    current-index <=> SettingsState.encoder-index;
                }
            }
            Field {
                label: "Frame rate";
                SpinBox {
                    width: 140px;
                    value <=> SettingsState.fps;
                    minimum: 1;
                    maximum: 240;
                }
            }
            Field {
                label: "Bitrate (kbps)";
                SpinBox {
                    width: 140px;
                    value <=> SettingsState.bitrate-kbps;
                    minimum: 1000;
                    maximum: 200000;
                    step-size: 1000;
                }
            }
            Field {
                label: "Capture mouse cursor";
                CheckBox { checked <=> SettingsState.show-cursor; }
            }
        }

        Section {
            heading: "Audio";
            Field {
                label: "Record audio";
                CheckBox { checked <=> SettingsState.audio-enabled; }
            }
            Field {
                label: "Separate microphone track";
                CheckBox { checked <=> SettingsState.separate-tracks; }
            }
            Field {
                label: "Bitrate (kbps)";
                SpinBox {
                    width: 140px;
                    value <=> SettingsState.audio-bitrate-kbps;
                    minimum: 64;
                    maximum: 320;
                    step-size: 32;
                }
            }
            Hint { text: "Tick the devices to capture. Outputs are captured through loopback, inputs are microphones. Volume and mute apply immediately."; }
            for row in SettingsState.audio-sources: HorizontalLayout {
                spacing: 12px;
                alignment: start;
                CheckBox {
                    checked <=> row.enabled;
                    width: 24px;
                }
                Text {
                    text: row.connected ? row.name : row.name + " (not connected)";
                    width: 300px;
                    vertical-alignment: center;
                    font-size: 13px;
                    overflow: elide;
                    color: row.connected ? Palette.foreground : Palette.foreground.with-alpha(0.5);
                }
                Text {
                    text: row.kind == "output" ? "Output" : "Input";
                    width: 56px;
                    vertical-alignment: center;
                    font-size: 12px;
                    color: Palette.foreground.with-alpha(0.6);
                }
                Slider {
                    width: 150px;
                    minimum: 0;
                    maximum: 200;
                    value <=> row.volume;
                    enabled: row.enabled && !row.muted;
                }
                Text {
                    text: "\{round(row.volume)}%";
                    width: 46px;
                    vertical-alignment: center;
                    font-size: 12px;
                }
                CheckBox {
                    text: "Mute";
                    checked <=> row.muted;
                    enabled: row.enabled;
                }
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: "Refresh devices";
                    clicked => { SettingsState.refresh-audio-devices(); }
                }
            }
        }

        Section {
            heading: "Games";
            Field {
                label: "Capture";
                ComboBox {
                    width: 360px;
                    model: ["Always capture the selected display", "Only while a known game is running"];
                    current-index <=> SettingsState.games-scope-index;
                }
            }
            Hint { text: SettingsState.running-games; }
            for profile in SettingsState.game-profiles: HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    if profile.has-icon: Image {
                        width: 24px;
                        height: 24px;
                        x: 2px;
                        y: 2px;
                        source: profile.icon;
                    }
                }
                VerticalLayout {
                    width: 220px;
                    Text {
                        text: profile.name == "" ? profile.exe : profile.name;
                        font-size: 13px;
                        overflow: elide;
                    }
                    Text {
                        text: profile.exe;
                        font-size: 11px;
                        color: Palette.foreground.with-alpha(0.6);
                        overflow: elide;
                    }
                }
                ComboBox {
                    width: 150px;
                    model: ["Replay buffer", "Full recording", "Do nothing"];
                    current-index <=> profile.action-index;
                }
                SpinBox {
                    width: 110px;
                    value <=> profile.replay-seconds;
                    minimum: 0;
                    maximum: 1200;
                }
                LineEdit {
                    width: 130px;
                    text <=> profile.subfolder;
                    placeholder-text: "Subfolder";
                }
                ComboBox {
                    width: 170px;
                    model: SettingsState.profile-display-names;
                    current-index <=> profile.display-index;
                }
                Button {
                    text: "Remove";
                    clicked => { SettingsState.remove-game(profile.exe); }
                }
            }
            if SettingsState.game-profiles.length > 0: Hint { text: "Buffer length 0 keeps the global setting. Subfolder is created inside the clips folder."; }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                ComboBox {
                    width: 300px;
                    model: SettingsState.running-known;
                    current-index <=> SettingsState.running-known-index;
                    enabled: SettingsState.running-known.length > 0;
                }
                Button {
                    text: "Add running game";
                    enabled: SettingsState.running-known.length > 0;
                    clicked => { SettingsState.add-running-game(); }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                LineEdit {
                    width: 200px;
                    text <=> SettingsState.new-game-exe;
                    placeholder-text: "game.exe";
                }
                LineEdit {
                    width: 200px;
                    text <=> SettingsState.new-game-name;
                    placeholder-text: "Display name (optional)";
                }
                Button {
                    text: "Add";
                    clicked => { SettingsState.add-game(); }
                }
                Button {
                    text: SettingsState.steam-busy ? "Asking Steam..." : "Suggest names from Steam";
                    enabled: !SettingsState.steam-busy;
                    clicked => { SettingsState.suggest-steam-names(); }
                }
            }
            Hint { text: "Names come from the bundled database. The Steam lookup is optional and only runs when you press the button; it fills empty names for the executables above."; }
            if SettingsState.games-message != "": Text {
                text: SettingsState.games-message;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        Section {
            heading: "Replay buffer";
            Field {
                label: "Keep the last";
                SpinBox {
                    width: 140px;
                    value <=> SettingsState.replay-length-value;
                    minimum: 1;
                    maximum: 1200;
                }
                ComboBox {
                    width: 140px;
                    model: ["seconds", "minutes"];
                    current-index <=> SettingsState.replay-unit-index;
                }
            }
            Field {
                label: "Memory cap (MB)";
                SpinBox {
                    width: 140px;
                    value <=> SettingsState.memory-cap-mb;
                    minimum: 64;
                    maximum: 32768;
                    step-size: 128;
                }
            }
            Field {
                label: "Start buffer on launch";
                CheckBox { checked <=> SettingsState.start-on-launch; }
            }
            Hint { text: "The buffer lives entirely in memory. Nothing is written to disk until a clip is saved."; }
        }

        Section {
            heading: "Output";
            Field {
                label: "Clips folder";
                LineEdit {
                    width: 320px;
                    text <=> SettingsState.clips-dir;
                }
                Button {
                    text: "Browse";
                    clicked => { SettingsState.browse-clips-dir(); }
                }
            }
            Field {
                label: "Recordings subfolder";
                LineEdit {
                    width: 320px;
                    text <=> SettingsState.recording-subfolder;
                    placeholder-text: "Leave empty to use the clips folder";
                }
            }
            Field {
                label: "File name pattern";
                LineEdit {
                    width: 320px;
                    text <=> SettingsState.file-name-pattern;
                    placeholder-text: "{game} {date} {time}";
                }
            }
        }

        Section {
            heading: "Hotkeys";
            HotkeyRow { label: "Save replay"; action: 0; binding <=> SettingsState.hotkey-save-replay; }
            HotkeyRow { label: "Start or stop replay buffer"; action: 1; binding <=> SettingsState.hotkey-toggle-buffer; }
            HotkeyRow { label: "Start or stop recording"; action: 2; binding <=> SettingsState.hotkey-toggle-recording; }
            Hint { text: "Click Change, then press the key combination. Escape cancels."; }
        }

        Section {
            heading: "General";
            Field {
                label: "Start minimized to tray";
                CheckBox { checked <=> SettingsState.start-minimized; }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                text: "Save";
                primary: true;
                clicked => { SettingsState.save(); }
            }
            Button {
                text: "Revert";
                clicked => { SettingsState.revert(); }
            }
        }
    }
}
