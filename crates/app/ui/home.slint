import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { I18n } from "i18n.slint";
import { Icon, Icons } from "icons.slint";
import { TextButton, Notice, KeyPill } from "widgets.slint";
import { ClipCard } from "types.slint";

component RecentCard inherits Rectangle {
    in property <ClipCard> card;
    callback clicked();
    border-radius: Theme.radius-small;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border : transparent;
    clip: true;
    animate background, border-color { duration: Theme.quick; }
    touch := TouchArea { clicked => { root.clicked(); } }
    VerticalLayout {
        Rectangle {
            height: root.width * 9 / 16;
            background: #000;
            if root.card.has-thumbnail: Image {
                width: parent.width;
                height: parent.height;
                source: root.card.thumbnail;
                image-fit: cover;
            }
            if !root.card.has-thumbnail: Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: 20px;
                data: Icons.clapperboard;
                color: Theme.text-faint;
            }
            Rectangle {
                x: parent.width - self.width - 6px;
                y: parent.height - self.height - 6px;
                width: dur.preferred-width + 10px;
                height: 18px;
                border-radius: 4px;
                background: #000000c0;
                dur := Text {
                    x: 5px;
                    y: (parent.height - self.height) / 2;
                    text: root.card.duration;
                    color: white;
                    font-size: 10px;
                    font-weight: 700;
                }
            }
        }
        VerticalLayout {
            padding: 8px;
            spacing: 2px;
            Text { text: root.card.title; font-size: 11px; font-weight: 600; color: Theme.text; overflow: elide; }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                if root.card.has-icon: Image { width: 11px; height: 11px; source: root.card.icon; }
                Text { text: root.card.game + "  \u{00b7}  " + root.card.date; font-size: 10px; color: Theme.text-muted; overflow: elide; }
            }
        }
    }
}

export component HomePage inherits ScrollView {
    in property <string> startup-warning;
    in property <bool> buffer-active;
    in property <string> buffer-status;
    in property <string> buffer-detail;
    in property <string> capture-error;
    in property <string> capture-notice;
    in property <string> save-status;
    in property <bool> recording-active;
    in property <string> recording-status;
    in property <string> recording-message;
    in property <string> detected-game;
    in property <[string]> save-keys;
    in property <string> save-label;
    in property <[ClipCard]> recent;

    callback toggle-buffer();
    callback save-clip();
    callback toggle-recording();
    callback open-clip(string);
    callback show-clips();

    property <length> gap: 12px;
    property <length> min-card-width: 170px;

    VerticalLayout {
        padding: Theme.page-padding;
        padding-top: 20px;
        spacing: 16px;
        alignment: start;

        if root.startup-warning != "": Notice { message: root.startup-warning; kind: 1; }
        if root.capture-error != "": Notice { message: root.capture-error; kind: 2; }
        if root.capture-notice != "": Notice { message: root.capture-notice; kind: 1; }

        // One compact status strip; the details live in Settings.
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding: 14px;
                padding-left: 18px;
                spacing: 14px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.recording-active ? Theme.record : (root.buffer-active ? Theme.accent : Theme.text-faint);
                    animate background { duration: Theme.quick; }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: root.recording-active ? root.recording-status : root.buffer-status;
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Text {
                        text: root.buffer-active ? root.buffer-detail : I18n.tr("Start the buffer to keep the last moments in memory.");
                        font-size: 11px;
                        color: Theme.text-muted;
                        overflow: elide;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                KeyPill { y: (parent.height - self.height) / 2; keys: root.save-keys; }
                Text { text: root.save-label; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; }
                TextButton {
                    text: root.buffer-active ? I18n.tr("Stop buffer") : I18n.tr("Start buffer");
                    icon: root.buffer-active ? Icons.stop : Icons.play;
                    has-icon: true;
                    clicked => { root.toggle-buffer(); }
                }
                TextButton {
                    text: I18n.tr("Save clip");
                    icon: Icons.scissors;
                    has-icon: true;
                    kind: 1;
                    enabled: root.buffer-active;
                    clicked => { root.save-clip(); }
                }
                TextButton {
                    text: root.recording-active ? I18n.tr("Stop recording") : I18n.tr("Record");
                    icon: root.recording-active ? Icons.stop : Icons.circle-dot;
                    has-icon: true;
                    kind: root.recording-active ? 2 : 0;
                    clicked => { root.toggle-recording(); }
                }
            }
        }
        if root.save-status != "" || root.recording-message != "": Text {
            text: root.recording-message != "" ? root.recording-message : root.save-status;
            font-size: 12px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 10px;
            Text { text: I18n.tr("Recent clips"); font-size: 18px; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
            TextButton { text: I18n.tr("All clips"); icon: Icons.film; has-icon: true; kind: 3; clicked => { root.show-clips(); } }
        }

        if root.recent.length == 0: Text {
            text: I18n.tr("No clips yet. Save one with the hotkey while the buffer is running.");
            font-size: 13px;
            color: Theme.text-muted;
        }

        Rectangle {
            property <int> columns: max(1, floor((self.width + root.gap) / (root.min-card-width + root.gap)));
            property <length> card-width: (self.width - root.gap * (self.columns - 1)) / self.columns;
            property <length> card-height: self.card-width * 9 / 16 + 50px;
            height: ceil(root.recent.length / self.columns) * (self.card-height + root.gap);
            for card[i] in root.recent: RecentCard {
                x: mod(i, parent.columns) * (parent.card-width + root.gap);
                y: floor(i / parent.columns) * (parent.card-height + root.gap);
                width: parent.card-width;
                height: parent.card-height;
                card: card;
                clicked => { root.open-clip(card.id); }
            }
        }

        Text {
            text: I18n.tr("Closing the window keeps OpenClips in the tray. Quit from the tray menu.");
            font-size: 11px;
            color: Theme.text-faint;
        }
    }
}
